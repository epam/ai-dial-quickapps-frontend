# See README.md for full documentation of all variables.

# --- Server ---
PORT=

# --- Authentication (NextAuth) ---
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# Configure one or more providers below; only fully-configured providers are enabled.
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Keycloak
AUTH_KEYCLOAK_ISSUER=
AUTH_KEYCLOAK_CLIENT_ID=
AUTH_KEYCLOAK_CLIENT_SECRET=
AUTH_KEYCLOAK_NAME=
AUTH_KEYCLOAK_SCOPE=

# Azure AD
AUTH_AZURE_AD_CLIENT_ID=
AUTH_AZURE_AD_CLIENT_SECRET=
AUTH_AZURE_AD_TENANT_ID=
AUTH_AZURE_AD_NAME=

# Google
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_NAME=
AUTH_GOOGLE_SCOPE=

# Auth0
AUTH_AUTH0_CLIENT_ID=
AUTH_AUTH0_CLIENT_SECRET=
AUTH_AUTH0_ISSUER=
AUTH_AUTH0_NAME=
AUTH_AUTH0_SCOPE=
AUTH_AUTH0_AUDIENCE=

# Okta
AUTH_OKTA_CLIENT_ID=
AUTH_OKTA_CLIENT_SECRET=
AUTH_OKTA_ISSUER=
AUTH_OKTA_NAME=
AUTH_OKTA_SCOPE=

# Cognito
AUTH_COGNITO_CLIENT_ID=
AUTH_COGNITO_CLIENT_SECRET=
AUTH_COGNITO_ISSUER=
AUTH_COGNITO_NAME=
AUTH_COGNITO_SCOPE=

# GitLab
AUTH_GITLAB_CLIENT_ID=
AUTH_GITLAB_SECRET=
AUTH_GITLAB_HOST=
AUTH_GITLAB_NAME=
AUTH_GITLAB_SCOPE=

# --- DIAL core ---
DIAL_CORE_URL=

# --- Chat visualizer connector ---
# Origin of the admin host this app is embedded in (default target for the connector).
DIAL_ADMIN_URL=
# Origin of the ai-dial-chat host. Used instead of DIAL_ADMIN_URL when embedded directly in chat.
DIAL_CHAT_URL=
# Visualizer name; must match the "title" configured for this app in ai-dial-chat's visualizer settings.
QUICK_APPS_APPLICATION_NAME=

# --- Themes ---
# Must point directly to config.json, not the base URL.
THEMES_URL=

# --- Feature flags ---
CODE_INTERPRETER_ENABLED=
WEB_FETCH_ENABLED=
ADD_ATTACHMENT_ENABLED=

# --- Security ---
# Space-separated list of origins allowed to embed this app in an <iframe> (CSP frame-ancestors).
# Set to the exact ai-dial-chat URL in production. Defaults to 'self' if unset.
ALLOWED_FRAME_ANCESTORS=
# Origin allowed to send postMessage events to the editor iframe.
# Set to the exact ai-dial-chat URL in production; * is unsafe outside local dev.
ALLOWED_ORIGIN=*
QUICK_APPS_DEFAULT_MODEL=gpt-4o



