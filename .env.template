# Runtime environment for the built Docker image (see ./Dockerfile). This
# image is chat-api's own server with this app's static build layered on top
# (docs/TRANSITION_PLAN.md Phase 2) — every variable below is chat-api's own,
# not this repo's. Nothing here is read at build time; `npm run build`
# produces a static bundle with no env vars baked in. See chat-api's own
# .env.template/README for the authoritative, full list — this is the subset
# this deployment actually needs, per docs/TRANSITION_PLAN.md Appendix B.
#
# For local dev (`npm run dev`), none of this is needed — see vite.config.ts.

# --- Server ---
# 4600 matches this app's own Vite dev port (vite.config.ts), so the app is
# reachable at the same URL whether you're running `npm run dev` or the built
# Docker image. The Dockerfile bakes this in as the image's own default.
PORT=4600
API_PREFIX=api

# --- DIAL core ---
DIAL_CORE_URL=

# --- Auth: session ---
# 64 hex characters. AUTH_SESSION_PREV_SECRET is available for zero-downtime rotation.
AUTH_SESSION_SECRET=
AUTH_SESSION_PREV_SECRET=
# Origin(s) this app is served from, e.g. https://quickapps.example.com. Also
# where the popup sign-in's callbackUrl must live.
AUTH_CALLBACK_BASE_URL=
CORS_ORIGIN=
# Renamed away from chat's own `chat.*` defaults, __Host- prefix kept.
AUTH_SESSION_COOKIE_NAME=__Host-quickapps.sess
AUTH_TRANSACTION_COOKIE_NAME=__Host-quickapps.tx
# Comma-separated. Only needed when migrating from an older cookie name.
AUTH_LEGACY_COOKIE_NAMES=

# --- Auth: identity provider(s) ---
# Configure at least one. Variable names are per-provider — see chat-api's
# own .env.template for the exact set (issuer/host/client id/client secret
# names differ slightly per provider). Example for Keycloak:
AUTH_KEYCLOAK_HOST=
AUTH_KEYCLOAK_CLIENT_ID=
AUTH_KEYCLOAK_SECRET=

# --- Themes ---
# Base URL; chat-api appends /config.json itself.
THEMES_CONFIG_URL=

# --- Iframe embedding / overlay ---
# Space-separated list of origins allowed to embed this app (admin/chat hosts).
ALLOWED_IFRAME_ORIGINS=
# Leave unset unless SameSite=None is actually required — see Phase 0 item 2.
OVERLAY_ENABLED=

# --- CSP ---
# report-only until violation reports are clean, then enforce — see §2.6.
CSP_MODE=report-only
ALLOWED_CONNECT_ORIGINS=

# --- Default model ---
DEFAULT_DEPLOYMENT=

# --- QuickApps-specific settings (Phase 0, item 1) ---
# A single JSON object. Keys map 1:1 onto AppSettings (src/types/dial-entities.ts):
#   allowedOrigin    — origin allowed to postMessage with the editor iframe
#   dialAdminHost    — admin host origin (visualizer connector default target)
#   dialChatHost     — ai-dial-chat host origin (used instead of dialAdminHost when embedded directly in chat)
#   applicationName  — visualizer name, must match the "title" configured in ai-dial-chat
CUSTOM_CLIENT_VARIABLES={"allowedOrigin":"","dialAdminHost":"","dialChatHost":"","applicationName":""}

# --- OpenTelemetry ---
# Disabled by default; set to false plus the OTEL_* vars below to enable.
OTEL_SDK_DISABLED=true
# OTEL_SERVICE_NAME=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_PROTOCOL=
# OTEL_METRICS_EXPORTER=
