# URL to the themes configuration JSON served by the DIAL themes service.
# Server-side only (no NEXT_PUBLIC_ prefix) — fetched via /api/themes proxy to avoid CORS.
# Must point directly to the config.json file, not the base URL.
# If unset, the app falls back to the CSS variable defaults in globals.css.
# Example: https://themes.example.com/config.json
THEMES_URL=

# Origin that is allowed to send postMessages to the /editor iframe.
# In production set this to the exact URL of ai-dial-chat (e.g. https://chat.example.com).
# Leaving it as * accepts messages from any origin — safe for local dev, unsafe for production.
NEXT_PUBLIC_ALLOWED_ORIGIN=*

# Default model ID pre-selected in the QuickApp2 form when no model is saved in the app config.
NEXT_PUBLIC_QUICK_APPS_DEFAULT_MODEL=gpt-4o

# applicationTypeSchemaId that identifies a QuickApp2 application.
# Override only if your DIAL instance uses a non-standard schema registry URL.
NEXT_PUBLIC_QUICK_APPS_SCHEMA_2_ID=https://mydial.epam.com/custom_application_schemas/quickapps2
